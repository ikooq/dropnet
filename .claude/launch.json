{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dropnet",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "dropnet", "serve", "--reset", "--port", "8765"],
      "port": 8765
